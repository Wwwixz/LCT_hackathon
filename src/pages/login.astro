---
import AuthCard from "../components/AuthCard";
---

<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>112-симулятор — Вход</title>
  </head>
  <body class="min-h-screen bg-[#0E1423] relative overflow-hidden flex items-center justify-center p-6">
    <div
      class="absolute inset-0"
      style="background: linear-gradient(135deg, #0E1423 32%, #DC2626 100%);"
    >
    </div>

    <div
      class="absolute inset-0 opacity-[0.07]"
      style="background-image: linear-gradient(to right, #ffffff 1px, transparent 1px), linear-gradient(to bottom, #ffffff 1px, transparent 1px); background-size: 80px 80px;"
    >
    </div>

    <div class="absolute -left-[220px] -top-[400px] h-[900px] w-[900px] rounded-full border border-white/20"></div>

    <div class="relative z-10">
      <AuthCard client:load defaultTab="login" />
    </div>
  </body>
</html>
